#!/bin/sh
# tm — validate the plan tree before every commit (tm-spec-v1.md §1.3, §14).
#
# Enable it once, from the repository root:
#
#     git config core.hooksPath plan/.githooks
#
# `tm check` exits 0 when the tree is clean and 2 when it has validation
# problems (duplicate ids, dangling parents, cycles, bad values); anything
# non-zero aborts the commit. Bypass one commit with `git commit --no-verify`.

set -u

plan=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd) || exit 1

if ! command -v tm >/dev/null 2>&1; then
	echo "pre-commit: tm is not on PATH — skipping tm check" >&2
	exit 0
fi

exec tm check --dir "$plan"
